      "Edit(//**/.worktrees/*/iteration-*/**/pressure/output/**)",
      "Edit(//**/.worktrees/*/iteration-*/**/quant/output/**)",
      "Bash(command -v *)",
      "Bash(prettier *)",
      "Bash(claude plugin validate *)",
      "Bash(git rev-parse --is-inside-work-tree)",
      "Bash(cp */.tesseract/**)",
      "Bash(mkdir -p */.tesseract/**)",
      "Bash(echo * >> */.tesseract/**)",
      "Bash(printf * >> */.tesseract/**)",
      "Read(//**/.tesseract/**)",
      "Edit(//**/.tesseract/**)",
      "Search(//**/.tesseract/**)",
      "Bash(mkdir -p ~/.tesseract/shelf && ls -la ~/.tesseract/shelf/ 2>/dev/null)",
      "Bash(* --help)",
      "Bash(* --version)",
      "Bash(bats *)",
      "Bash(bats tests/test_sync_theme.bats)",
      "Bash(brew list:*)",
      "Bash(cat *)",
      "Bash(cat ~/.claude/cost-log/**)",
      "Bash(command -v trash)",
      "Bash(cp */CHECKPOINT.md */.checkpoints/**)",
      "Bash(mv */CHECKPOINT.md */.checkpoints/**)",
      "Bash(echo \"exit: $?\")",
      "Bash(find *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(diff *)",
      "Bash(git add *)",
      "Bash(git -C * add *)",
      "Bash(git diff *)",
      "Bash(git -C * diff *)",
      "Bash(git check-ignore:*)",
      "Bash(git -C * check-ignore:*)",
      "Bash(git log *)",
      "Bash(git -C * log *)",
      "Bash(git rev-parse *)",
      "Bash(git -C * rev-parse *)",
      "Bash(git show *)",
      "Bash(git -C * show *)",
      "Bash(git status)",
      "Bash(git -C * status)",
      "Bash(git status --short)",
      "Bash(git -C * status --short)",
      "Bash(git branch --show-current)",
      "Bash(git -C * branch --show-current)",
      "Bash(git status --porcelain)",
      "Bash(git -C * status --porcelain)",
      "Bash(git worktree list *)",
      "Bash(git -C * worktree list *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(launchctl list *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(npm install:*)",
      "Bash(npm ls *)",
      "Bash(npm run build)",
      "Bash(npm run test *)",
      "Bash(npm test *)",
      "Bash(npm view *)",
      "Bash(npx jest *)",
      "Bash(npx vitest *)",
      "Bash(python3 -m pytest tests/ *)",
      "Bash(rg *)",
      "Bash(sed *)",
      "Bash(uv add:*)",
      "Bash(uv run behave *)",
      "Bash(uv run pytest *)",
      "Bash(uv run python -m pytest *)",
      "Bash(uv run python -m skills.sync.scripts.sync --mode plan *)",
      "Bash(uv run ruff check *)",
      "Bash(uv run ruff format *)",
      "Bash(uv run uvicorn *)",
      "Bash(uv run ruff *)",
      "Bash(uv run ty *)",
      "Bash(uv sync *)",
      "Bash(uvx pytest *)",
      "Bash(uvx tox *)",
      "Bash(wc *)",
      "Read(.)",
      "Read(//**/.claude/**)",
      "Read(//**/.awesome/**)",
      "Read(//**/.local/**)",
      "Read(//**/.zprofile)",
      "Read(//**/.zshrc)",
      "Search(.)",
      "Search(~/.claude/**)",
      "Skill(expert-review)",
      "Skill(keybindings-help)",
      "Skill(remember)",
      "Skill(remember:remember)",
      "Edit(.checkpoints/**)",
      "Edit(.remember/**)",
      "Edit(//*/CHECKPOINT.md)",
      "Edit(~/.claude/COST-SUMMARY.md)",
      "Edit(~/.claude/cost-log/**)",
      "Edit(~/.claude/extract_cost.py)",
      "Bash(gh search *)",
      "Bash(gh api repos/*/comments --jq '*')",
      "Bash(gh api repos/*/comments --paginate)",
      "Bash(gh api repos/*/comments --paginate --jq '*')",
      "Bash(gh api repos/*/reviews)",
      "Bash(gh api repos/*/check-runs)",
      "Bash(gh pr diff *)",
      "Bash(flutter analyze *)",
      "Bash(flutter test*)",
      "Bash(flutter pub *)",
      "Bash(flutter doctor *)",
      "mcp__plugin_chrome-devtools-mcp_chrome-devtools__navigate_page",
      "mcp__plugin_chrome-devtools-mcp_chrome-devtools__take_screenshot",
      "mcp__plugin_chrome-devtools-mcp_chrome-devtools__resize_page",
      "mcp__plugin_chrome-devtools-mcp_chrome-devtools__list_console_messages",
      "mcp__plugin_chrome-devtools-mcp_chrome-devtools__lighthouse_audit",
      "mcp__plugin_chrome-devtools-mcp_chrome-devtools__new_page",
      "mcp__plugin_chrome-devtools-mcp_chrome-devtools__list_pages",
      "Bash(pkill -f \"chrome-devtools-mcp/chrome-profile\")",
      "Bash(setopt NO_NOMATCH)",
      "Bash(dart format *)",
      "Bash(git switch -c *)",
      "Bash(git stash apply *)",
      "Bash(git stash push *)",
      "Read(//tmp/**)",
      "Read(//private/tmp/**)",
      "Bash(npx --yes lighthouse *)",
      "Bash(./gradlew :app:testDebugUnitTest --rerun-tasks)",
      "Bash(./gradlew :app:testDebugUnitTest)"
    ],
    "deny": [
      "Bash(*gh pr close*)",
      "Bash(*gh pr comment*)",
      "Bash(*gh pr create*)",
      "Bash(*gh pr edit*)",
      "Bash(*gh pr merge*)",
      "Bash(*gh pr ready*)",
      "Bash(*gh pr reopen*)",
      "Bash(gh api *--method DELETE*)",
      "Bash(gh api *--method PATCH*)",
      "Bash(gh api *--method POST*)",
      "Bash(gh api *--method PUT*)",
      "Bash(gh api *-X DELETE*)",
      "Bash(gh api *-X PATCH*)",
      "Bash(gh api *-X POST*)",
      "Bash(gh api *-X PUT*)",
      "Bash(gh api *-f *=*)",
      "Bash(gh api *-f body=*)",
      "Bash(gh api graphql*-f query=*mutation*)",
      "Bash(gh gist create*)",
      "Bash(gh gist delete*)",
      "Bash(gh gist edit*)",
      "Bash(gh issue reopen*)",
      "Bash(gh issue transfer*)",
      "Bash(gh label create*)",
      "Bash(gh label delete*)",
      "Bash(gh label edit*)",
      "Bash(gh release create*)",
      "Bash(gh release delete*)",
      "Bash(gh release edit*)",
      "Bash(gh repo archive*)",
      "Bash(gh repo create*)",
      "Bash(gh repo delete*)",
      "Bash(gh repo edit*)",
      "Bash(gh repo fork*)",
      "Bash(gh repo rename*)",
      "Bash(gh run cancel*)",
      "Bash(gh run rerun*)",
      "Bash(gh workflow run*)",
      "Bash(*git commit*)",
      "Bash(rm *)",
      "Bash(* rm *)",
      "Bash(*/rm *)"
    ],
    "ask": [
      "Bash(*gh issue create*)",
      "Bash(*gh issue close*)",
      "Bash(*gh issue comment*)",
      "Bash(*gh issue delete*)",
      "Bash(*gh issue edit*)",
      "Bash(*settings.json*)",
      "Bash(find*-delete*)",
      "Bash(find*-exec*)",
      "Bash(sed*-i*)",
      "Edit(*settings.json*)",
      "Bash(*gh pr review*)"
    ],
    "defaultMode": "default"
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/ensure_remember_logs_dir.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/block-inline-scripts.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/check_git_rev_parse.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/block_opus_subagent.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "code-review@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "remember@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "legalzoom@claude-plugins-official": true,
    "claude-damn@claude-community": true
  },
  "extraKnownMarketplaces": {
    "claude-community": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-community"
      }
    }
  },
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "prefersReducedMotion": true,
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "verbose": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": false,
  "useAutoModeDuringPlan": false
}
